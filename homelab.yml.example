# homelab.yml — single source of truth for all infrastructure configuration
#
# This is the ONLY file you need to edit. The `iac` CLI reads this file and
# generates all tool-specific configs (Ansible inventory, Terraform tfvars)
# automatically. You never edit those generated files directly.
#
# Copy this file to homelab.yml and fill in your values:
#   cp homelab.yml.example homelab.yml

cluster:
  name: homelab

hosts:
  homelab-host-01:
    ip: 192.168.1.10            # Server 1 IP on home LAN
    nat_subnet: 192.168.122.0/24 # Private NAT subnet for VMs
    wireguard_endpoint: true     # This host runs the WireGuard VPN server
  homelab-host-02:
    ip: 192.168.1.11            # Server 2 IP on home LAN
    nat_subnet: 192.168.123.0/24

vpn:
  subnet: 10.0.0.0/24           # VPN client subnet
  endpoint: home.example.com    # Public hostname or IP for remote clients
  port: 51820                   # WireGuard listen port (UDP)
  lan_routes:
    - 192.168.1.0/24            # Home LAN subnets routed to VPN clients

storage:
  media_path: /mnt/media         # Host path for media libraries
  downloads_path: /mnt/downloads # Host path for download staging
  config_path: /mnt/config       # Host path for application config/databases

apps:
  plex:
    enabled: true
    image: linuxserver/plex:latest
    port: 32400
  sonarr:
    enabled: true
    image: linuxserver/sonarr:latest
    port: 8989
  radarr:
    enabled: true
    image: linuxserver/radarr:latest
    port: 7878
  bazarr:
    enabled: true
    image: linuxserver/bazarr:latest
    port: 6767

auto_update:
  enabled: true
  schedule: "0 3 * * *"         # Cron expression: daily at 3 AM

secrets:
  ssh_key_path: ~/.ssh/id_ed25519 # Path to SSH private key
  ssh_user: admin                 # SSH user for server access
