job "auto-updater" {
  datacenters = ["{{.Datacenter}}"]
  type        = "batch"

  periodic {
    cron             = "{{.Schedule}}"
    prohibit_overlap = true
    time_zone        = "UTC"
  }

  group "updater" {
    count = 1

    task "check-updates" {
      driver = "docker"

      config {
        image = "docker:24-cli"

        command = "/bin/sh"
        args    = ["-c", "/local/update-check.sh"]

        volumes = [
          "/var/run/docker.sock:/var/run/docker.sock:ro"
        ]
      }

      template {
        data = <<EOF
#!/bin/sh
set -e

echo "Starting image update check at $(date)"

NOMAD_ADDR="${NOMAD_ADDR:-http://localhost:4646}"
UPDATED=false

{{- range .Apps}}
# Check {{.}} for updates
echo "Checking {{.}} for updates..."

# Get current image from Nomad job
CURRENT_IMAGE=$(nomad job inspect {{.}} | jq -r '.Job.TaskGroups[0].Tasks[0].Config.image')

if [ -z "$CURRENT_IMAGE" ]; then
  echo "Could not determine current image for {{.}}"
  continue
fi

echo "Current image: $CURRENT_IMAGE"

# Pull latest version
echo "Pulling latest image..."
docker pull "$CURRENT_IMAGE" > /dev/null 2>&1

# Get current running digest
RUNNING_DIGEST=$(docker inspect --format='{{{{.Image}}}}' "$(docker ps --filter name={{.}} -q)" 2>/dev/null || echo "")

# Get latest pulled digest
LATEST_DIGEST=$(docker inspect --format='{{{{.Id}}}}' "$CURRENT_IMAGE" 2>/dev/null || echo "")

if [ -z "$RUNNING_DIGEST" ] || [ -z "$LATEST_DIGEST" ]; then
  echo "Could not determine digests for {{.}}"
  continue
fi

echo "Running digest: $RUNNING_DIGEST"
echo "Latest digest:  $LATEST_DIGEST"

if [ "$RUNNING_DIGEST" != "$LATEST_DIGEST" ]; then
  echo "New version available for {{.}}, triggering deployment..."

  # Trigger Nomad job run
  nomad job run "/nomad/jobs/{{.}}.hcl"

  UPDATED=true
  echo "{{.}} updated successfully"
else
  echo "{{.}} is up to date"
fi

echo ""
{{- end}}

if [ "$UPDATED" = true ]; then
  echo "Update check completed with updates applied at $(date)"
else
  echo "Update check completed with no updates needed at $(date)"
fi
EOF

        destination = "local/update-check.sh"
        perms       = "755"
      }

      env {
        NOMAD_ADDR = "http://${attr.unique.network.ip-address}:4646"
      }

      resources {
        cpu    = 100
        memory = 128
      }
    }

    restart {
      attempts = 2
      delay    = "30s"
      interval = "5m"
      mode     = "fail"
    }
  }
}
